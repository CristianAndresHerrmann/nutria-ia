# Proveedor de IA: fake (simulado, determinístico, sin llamadas externas) | gemini | openai
AI_PROVIDER=fake
AI_PROVIDER_TIMEOUT_SECONDS=25
# Solo para AI_PROVIDER=fake: ok | invalid_output | timeout | provider_error
FAKE_PROVIDER_SCENARIO=ok

# Solo para gemini y openai. Modelo obligatorio, por ejemplo gemini-3.8-flash o gpt-6-luna.
AI_MODEL=
# gemini: minimal | low | medium | high. openai: none | minimal | low | medium | high | xhigh | max.
# Qué valores admite cada modelo lo decide su API.
AI_REASONING_LEVEL=low
# Claves de API: solo la del proveedor elegido es obligatoria. Nunca se versionan.
GEMINI_API_KEY=
OPENAI_API_KEY=
