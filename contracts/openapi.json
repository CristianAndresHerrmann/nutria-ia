{
  "components": {
    "schemas": {
      "CandidateRecipe": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "cooking_method": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CookingMethod"
              },
              {
                "type": "null"
              }
            ]
          },
          "meal_types": {
            "items": {
              "$ref": "#/components/schemas/MealType"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Meal Types",
            "type": "array"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "time_minutes": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1440.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Minutes"
          }
        },
        "required": [
          "code",
          "name",
          "meal_types"
        ],
        "title": "CandidateRecipe",
        "type": "object"
      },
      "Catalog": {
        "additionalProperties": false,
        "description": "Subconjunto del catálogo permitido para el paciente, ya sin los alimentos\nrechazados (RF-37). Lo arma el backend.",
        "properties": {
          "food_groups": {
            "items": {
              "$ref": "#/components/schemas/CatalogFoodGroup"
            },
            "maxItems": 500,
            "title": "Food Groups",
            "type": "array"
          },
          "foods": {
            "items": {
              "$ref": "#/components/schemas/CatalogFood"
            },
            "maxItems": 2000,
            "minItems": 1,
            "title": "Foods",
            "type": "array"
          }
        },
        "required": [
          "foods"
        ],
        "title": "Catalog",
        "type": "object"
      },
      "CatalogFood": {
        "additionalProperties": false,
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/FoodCategoryType"
            },
            "maxItems": 7,
            "title": "Categories",
            "type": "array"
          },
          "code": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "group_code": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Group Code",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "group_code"
        ],
        "title": "CatalogFood",
        "type": "object"
      },
      "CatalogFoodGroup": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "CatalogFoodGroup",
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "description": "Condición del paciente, solo con el nombre de la patología, alimento o grupo.\n\nLas observaciones no viajan: son texto libre y pueden traer datos personales.",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ConditionType"
          }
        },
        "required": [
          "type",
          "name"
        ],
        "title": "Condition",
        "type": "object"
      },
      "ConditionType": {
        "enum": [
          "pathology",
          "allergy",
          "intolerance",
          "rejection",
          "preference"
        ],
        "title": "ConditionType",
        "type": "string"
      },
      "ContractViolation": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg"
        ],
        "title": "ContractViolation",
        "type": "object"
      },
      "CookingContext": {
        "additionalProperties": false,
        "description": "Contexto de cocina (RF-08).",
        "properties": {
          "cooking_time": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooking Time"
          },
          "cooks": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooks"
          },
          "home_equipment": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Equipment"
          },
          "likes_cooking": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Likes Cooking"
          },
          "usual_shopping_place": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usual Shopping Place"
          }
        },
        "title": "CookingContext",
        "type": "object"
      },
      "CookingMethod": {
        "enum": [
          "oven",
          "stovetop",
          "microwave",
          "no_cooking"
        ],
        "title": "CookingMethod",
        "type": "string"
      },
      "FoodCategoryType": {
        "enum": [
          "protein",
          "carbohydrate",
          "fiber",
          "vegetable",
          "healthy_fat",
          "infusion",
          "complementary"
        ],
        "title": "FoodCategoryType",
        "type": "string"
      },
      "FoodGroupItem": {
        "additionalProperties": false,
        "description": "Referencia genérica, como \"una fruta\".",
        "properties": {
          "code": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "type": {
            "const": "food_group",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "code"
        ],
        "title": "FoodGroupItem",
        "type": "object"
      },
      "FoodItem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "type": {
            "const": "food",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "code"
        ],
        "title": "FoodItem",
        "type": "object"
      },
      "FreeTextItem": {
        "additionalProperties": false,
        "description": "Lo que el modelo no encontró en el catálogo. El backend lo guarda como ítem no\nreconocido con el texto original (DA-26).",
        "properties": {
          "text": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "free_text",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "FreeTextItem",
        "type": "object"
      },
      "GenerationErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/GenerationErrorCode"
          },
          "details": {
            "$ref": "#/components/schemas/GenerationErrorDetails"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "GenerationErrorBody",
        "type": "object"
      },
      "GenerationErrorCode": {
        "enum": [
          "PROVIDER_TIMEOUT",
          "PROVIDER_ERROR",
          "INVALID_PROVIDER_OUTPUT"
        ],
        "title": "GenerationErrorCode",
        "type": "string"
      },
      "GenerationErrorDetails": {
        "properties": {
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ContractViolation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo en INVALID_PROVIDER_OUTPUT: qué parte de la respuesta no respeta el contrato.",
            "title": "Errors"
          },
          "generation": {
            "$ref": "#/components/schemas/GenerationInfo"
          }
        },
        "required": [
          "generation"
        ],
        "title": "GenerationErrorDetails",
        "type": "object"
      },
      "GenerationErrorResponse": {
        "description": "Mismo formato que los errores del backend: { error: { code, message, details } }.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/GenerationErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "GenerationErrorResponse",
        "type": "object"
      },
      "GenerationInfo": {
        "description": "Datos de la llamada al proveedor que el backend registra en ai_generation\n(RF-41, RNF-11).",
        "properties": {
          "duration_ms": {
            "title": "Duration Ms",
            "type": "integer"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "raw_response": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Respuesta cruda del proveedor. Null solo si no respondió (timeout o falla).",
            "title": "Raw Response"
          },
          "template_version": {
            "title": "Template Version",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "template_version",
          "duration_ms"
        ],
        "title": "GenerationInfo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
